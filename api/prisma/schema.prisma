// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

enum ArticleSection {
  featured
  human_stories @map("human-stories")
  places
  traditions
  discover
  voices
  sports
  events
  news
  video
  campaigns
  gallery
}

enum TagKind {
  LOCATION
  TOPIC
  CATEGORY
}

enum PartnershipStatus {
  NEW
  REVIEW
  CONTACTED
  CLOSED
}

enum ContactInquiryStatus {
  NEW
  REVIEW
  REPLIED
  CLOSED
}

enum ContactInquiryCategory {
  BUSINESS
  STORY_TIP
  SPAM
  GENERAL
  UNKNOWN
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ArticleStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum TranslationStatus {
  PENDING
  RUNNING
  READY
  FAILED
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
}

enum NarrationStatus {
  IDLE
  PENDING
  RUNNING
  READY
  FAILED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String?
  role          Role           @default(EDITOR)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  files         FileObject[]
  refreshTokens RefreshToken[]
  todos         EditorialTodo[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  sessionId String    @map("session_id")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model FileObject {
  id           String   @id @default(cuid())
  key          String   @unique
  bucket       String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  url          String?
  userId       String?  @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("file_objects")
}

model Author {
  id                String            @id @default(cuid())
  slug              String            @unique
  nameBg            String            @map("name_bg")
  nameEn            String?           @map("name_en")
  roleBg            String            @map("role_bg")
  roleEn            String?           @map("role_en")
  locationBg        String?           @map("location_bg")
  locationEn        String?           @map("location_en")
  quoteBg           String?           @map("quote_bg")
  quoteEn           String?           @map("quote_en")
  bioBg             String?           @map("bio_bg")
  bioEn             String?           @map("bio_en")
  imageUrl          String?           @map("image_url")
  aliases           String[]          @default([])
  isActive          Boolean           @default(true) @map("is_active")
  translationStatus TranslationStatus @default(PENDING) @map("translation_status")
  translationError  String?           @map("translation_error")
  sourceLang        String?           @map("source_lang")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  articles          Article[]
  badges            AuthorBadge[]

  @@map("authors")
}

model MediaAsset {
  id           String    @id @default(cuid())
  key          String    @unique
  url          String
  mimeType     String    @map("mime_type")
  kind         MediaKind @default(IMAGE)
  originalName String?   @map("original_name")
  size         Int?
  titleBg      String?   @map("title_bg")
  titleEn      String?   @map("title_en")
  locationBg   String?   @map("location_bg")
  locationEn   String?   @map("location_en")
  creditBg     String?   @map("credit_bg")
  creditEn     String?   @map("credit_en")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  heroArticles  Article[]            @relation("ArticleHero")
  audioArticles Article[]            @relation("ArticleAudio")
  videoArticles Article[]            @relation("ArticleVideo")
  galleryItems  ArticleGalleryItem[]
  seriesCovers  Series[]
  products      Product[]
  productGalleryItems ProductGalleryItem[]

  @@map("media_assets")
}

model ArticleGalleryItem {
  id        String     @id @default(cuid())
  articleId String     @map("article_id")
  mediaId   String     @map("media_id")
  sortOrder Int        @default(0) @map("sort_order")
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([articleId, mediaId])
  @@index([articleId, sortOrder])
  @@map("article_gallery_items")
}

model Article {
  id                String               @id @default(cuid())
  section           ArticleSection
  slug              String
  path              String
  status            ArticleStatus        @default(DRAFT)
  publishedAt       DateTime?            @map("published_at")
  categoryBg        String               @map("category_bg")
  categoryEn        String?              @map("category_en")
  titleBg           String               @map("title_bg")
  titleEn           String?              @map("title_en")
  subtitleBg        String               @default("") @map("subtitle_bg")
  subtitleEn        String?              @map("subtitle_en")
  readTimeBg        String               @default("") @map("read_time_bg")
  readTimeEn        String?              @map("read_time_en")
  locationBg        String               @default("") @map("location_bg")
  locationEn        String?              @map("location_en")
  dateBg            String               @default("") @map("date_bg")
  dateEn            String?              @map("date_en")
  photoCreditBg     String               @default("") @map("photo_credit_bg")
  photoCreditEn     String?              @map("photo_credit_en")
  endLabelBg        String               @default("Край") @map("end_label_bg")
  endLabelEn        String?              @map("end_label_en")
  speakerBg         String?              @map("speaker_bg")
  speakerEn         String?              @map("speaker_en")
  audioDuration     String?              @map("audio_duration")
  /**
   * External playback URL (YouTube, Vimeo, direct file URL).
   */
  videoUrl          String?              @map("video_url")
  body              Json                 @default("[]")
  featured          Boolean              @default(false)
  sponsored         Boolean              @default(false)
  sponsorName       String?              @map("sponsor_name")
  behindStoryBg     String               @default("") @map("behind_story_bg")
  behindStoryEn     String?              @map("behind_story_en")
  seoTitleBg        String?              @map("seo_title_bg")
  seoTitleEn        String?              @map("seo_title_en")
  seoDescriptionBg  String?              @map("seo_description_bg")
  seoDescriptionEn  String?              @map("seo_description_en")
  translationStatus TranslationStatus    @default(PENDING) @map("translation_status")
  translationError  String?              @map("translation_error")
  sourceLang        String?              @map("source_lang")
  narrationStatus   NarrationStatus      @default(IDLE) @map("narration_status")
  narrationError    String?              @map("narration_error")
  /** Gemini text embedding (float vector) for semantic related articles. */
  embedding         Json?
  embeddingUpdatedAt DateTime?           @map("embedding_updated_at")
  authorId          String?              @map("author_id")
  author            Author?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  heroMediaId       String?              @map("hero_media_id")
  heroMedia         MediaAsset?          @relation("ArticleHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  audioMediaId      String?              @map("audio_media_id")
  audioMedia        MediaAsset?          @relation("ArticleAudio", fields: [audioMediaId], references: [id], onDelete: SetNull)
  videoMediaId      String?              @map("video_media_id")
  videoMedia        MediaAsset?          @relation("ArticleVideo", fields: [videoMediaId], references: [id], onDelete: SetNull)
  galleryItems      ArticleGalleryItem[]
  seriesEpisodes    SeriesEpisode[]
  articleTags       ArticleTag[]
  reactions         ArticleReaction[]
  socialPosts       SocialPost[]
  digestSends       EpisodeDigestSend[]
  savedBy           SavedArticle[]
  storyYearNominations StoryYearNomination[]
  donations         Donation[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([section, slug])
  @@index([status, section])
  @@index([authorId])
  @@map("articles")
}

/** Soft engagement — anonymous “I Relate” (reader accounts optional later). */
model ArticleReaction {
  id         String   @id @default(cuid())
  articleId  String   @map("article_id")
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  kind       String   @default("RELATE")
  visitorKey String   @map("visitor_key")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([articleId, kind, visitorKey])
  @@index([articleId, kind])
  @@map("article_reactions")
}

model Tag {
  id          String       @id @default(cuid())
  slug        String
  kind        TagKind
  nameBg      String       @map("name_bg")
  nameEn      String?      @map("name_en")
  articleTags ArticleTag[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([kind, slug])
  @@index([kind, nameBg])
  @@map("tags")
}

model ArticleTag {
  articleId String  @map("article_id")
  tagId     String  @map("tag_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

model PartnershipInquiry {
  id             String            @id @default(cuid())
  organization   String
  contactName    String            @map("contact_name")
  email          String
  phone          String?
  website        String?
  type           String
  budget         String?
  message        String
  honeypot       String?           @map("honeypot")
  status         PartnershipStatus @default(NEW)
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([email])
  @@map("partnership_inquiries")
}

model ContactInquiry {
  id             String                  @id @default(cuid())
  name           String
  email          String
  subject        String
  message        String
  honeypot       String?                 @map("honeypot")
  status         ContactInquiryStatus    @default(NEW)
  notes          String?
  aiCategory     ContactInquiryCategory? @map("ai_category")
  aiSummary      String?                 @map("ai_summary")
  classifiedAt   DateTime?               @map("classified_at")
  autoRepliedAt  DateTime?               @map("auto_replied_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([aiCategory, createdAt])
  @@index([email])
  @@map("contact_inquiries")
}

model Donation {
  id               String         @id @default(cuid())
  amountCents      Int            @map("amount_cents")
  currency         String         @default("bgn")
  status           DonationStatus @default(PENDING)
  email            String?
  name             String?
  articleId        String?        @map("article_id")
  article          Article?       @relation(fields: [articleId], references: [id], onDelete: SetNull)
  stripeSessionId  String?        @unique @map("stripe_session_id")
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([articleId])
  @@map("donations")
}

enum ShopOrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum ShopPaymentMethod {
  STRIPE
  COD
}

enum EstimatedArrivalDayType {
  BUSINESS
  CALENDAR
}

model Product {
  id                  String      @id @default(cuid())
  slug                String      @unique
  titleBg             String      @map("title_bg")
  titleEn             String?     @map("title_en")
  descriptionBg       String      @default("") @map("description_bg")
  descriptionEn       String?     @map("description_en")
  priceCents          Int         @map("price_cents")
  currency            String      @default("eur")
  stock               Int         @default(0)
  active              Boolean     @default(true)
  /** Allow cash / pay on delivery for this product. */
  allowCod            Boolean     @default(false) @map("allow_cod")
  /** Inclusive day range for COD ETA, e.g. 3–5. */
  estimatedArrivalMinDays Int?    @map("estimated_arrival_min_days")
  estimatedArrivalMaxDays Int?    @map("estimated_arrival_max_days")
  estimatedArrivalDayType EstimatedArrivalDayType? @map("estimated_arrival_day_type")
  /** Cached display strings generated from the day range (bg/en). */
  estimatedArrivalBg  String      @default("") @map("estimated_arrival_bg")
  estimatedArrivalEn  String?     @map("estimated_arrival_en")
  imageMediaId        String?     @map("image_media_id")
  imageMedia          MediaAsset? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  galleryItems        ProductGalleryItem[]
  orderItems          OrderItem[]
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  @@index([active, createdAt])
  @@map("products")
}

model ProductGalleryItem {
  id        String     @id @default(cuid())
  productId String     @map("product_id")
  mediaId   String     @map("media_id")
  sortOrder Int        @default(0) @map("sort_order")
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@map("product_gallery_items")
}

model ShopOrder {
  id                    String            @id @default(cuid())
  publicId              String            @unique @map("public_id")
  email                 String            @default("")
  status                ShopOrderStatus   @default(PENDING)
  paymentMethod         ShopPaymentMethod @default(STRIPE) @map("payment_method")
  totalCents            Int               @map("total_cents")
  currency              String            @default("eur")
  estimatedArrival      String?           @map("estimated_arrival")
  shippingName          String?           @map("shipping_name")
  shippingLine1         String?           @map("shipping_line1")
  shippingLine2         String?           @map("shipping_line2")
  shippingCity          String?           @map("shipping_city")
  shippingPostal        String?           @map("shipping_postal")
  shippingCountry       String?           @map("shipping_country")
  shippingPhone         String?           @map("shipping_phone")
  stripeSessionId       String?           @unique @map("stripe_session_id")
  stripePaymentIntentId String?           @map("stripe_payment_intent_id")
  paidAt                DateTime?         @map("paid_at")
  shippedAt             DateTime?         @map("shipped_at")
  deliveredAt           DateTime?         @map("delivered_at")
  items                 OrderItem[]
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([email])
  @@map("shop_orders")
}

model OrderItem {
  id             String    @id @default(cuid())
  orderId        String    @map("order_id")
  order          ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?   @map("product_id")
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  titleSnapshot  String    @map("title_snapshot")
  unitPriceCents Int       @map("unit_price_cents")
  qty            Int
  lineTotalCents Int       @map("line_total_cents")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum SeriesStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Series {
  id                String            @id @default(cuid())
  slug              String            @unique
  titleBg           String            @map("title_bg")
  titleEn           String?           @map("title_en")
  descriptionBg     String            @default("") @map("description_bg")
  descriptionEn     String?           @map("description_en")
  status            SeriesStatus      @default(DRAFT)
  coverMediaId      String?           @map("cover_media_id")
  coverMedia        MediaAsset?       @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  translationStatus TranslationStatus @default(PENDING) @map("translation_status")
  translationError  String?           @map("translation_error")
  sourceLang        String?           @map("source_lang")
  episodes          SeriesEpisode[]
  digestSends       EpisodeDigestSend[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("series")
}

model SeriesEpisode {
  id        String   @id @default(cuid())
  seriesId  String   @map("series_id")
  articleId String   @map("article_id")
  sortOrder Int      @default(0) @map("sort_order")
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([seriesId, articleId])
  @@index([seriesId, sortOrder])
  @@map("series_episodes")
}

enum SubmissionStatus {
  NEW
  REVIEW
  CHANGES
  APPROVED
  REJECTED
}

model Submission {
  id           String           @id @default(cuid())
  name         String
  email        String
  phone        String?
  place        String
  title        String
  category     String
  description  String
  story        String
  links        String?
  ownWork      Boolean          @default(true) @map("own_work")
  status       SubmissionStatus @default(NEW)
  photoUrls    Json             @default("[]") @map("photo_urls")
  documentUrls Json             @default("[]") @map("document_urls")
  notes        String?
  articleId    String?          @map("article_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([email])
  @@map("submissions")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  @default("website")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

enum SocialPostStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

model SocialPost {
  id            String           @id @default(cuid())
  articleId     String           @map("article_id")
  article       Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  platform      String
  status        SocialPostStatus @default(DRAFT)
  body          String
  hashtags      String           @default("")
  promptVersion String?          @map("prompt_version")
  scheduledAt   DateTime?        @map("scheduled_at")
  publishedAt   DateTime?        @map("published_at")
  externalId    String?          @map("external_id")
  error         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@unique([articleId, platform])
  @@index([status, updatedAt])
  @@index([platform, status])
  @@map("social_posts")
}

/** Singleton row: which platforms to generate for. */
model SocialWorkspaceSettings {
  id        String   @id @default("default")
  platforms String[] @default(["FACEBOOK", "INSTAGRAM", "TIKTOK"])
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_workspace_settings")
}

enum DigestSendStatus {
  SENT
  FAILED
}

model EpisodeDigestSend {
  id              String           @id @default(cuid())
  seriesId        String           @map("series_id")
  series          Series           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  articleId       String           @map("article_id")
  article         Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  status          DigestSendStatus @default(SENT)
  recipientCount  Int              @default(0) @map("recipient_count")
  resendId        String?          @map("resend_id")
  error           String?
  subject         String           @default("")
  sentAt          DateTime         @default(now()) @map("sent_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([seriesId, articleId])
  @@index([sentAt])
  @@map("episode_digest_sends")
}

model EditorialTodo {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean   @default(false)
  dueAt     DateTime? @map("due_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId, done, createdAt])
  @@map("editorial_todos")
}

/** Public reader identity (Magic Link) — separate from staff User. */
model Reader {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  locale       String?
  lastLoginAt  DateTime?            @map("last_login_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  magicLinks   MagicLinkToken[]
  refreshTokens ReaderRefreshToken[]
  savedArticles SavedArticle[]
  analyticsSessions AnalyticsSession[]
  storyYearVotes StoryYearVote[]

  @@map("readers")
}

model MagicLinkToken {
  id         String    @id @default(cuid())
  readerId   String    @map("reader_id")
  reader     Reader    @relation(fields: [readerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  intent     Json?
  returnUrl  String?   @map("return_url")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([readerId])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

model ReaderRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  sessionId String    @map("session_id")
  readerId  String    @map("reader_id")
  reader    Reader    @relation(fields: [readerId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([readerId])
  @@index([sessionId])
  @@map("reader_refresh_tokens")
}

model SavedArticle {
  id        String   @id @default(cuid())
  readerId  String   @map("reader_id")
  reader    Reader   @relation(fields: [readerId], references: [id], onDelete: Cascade)
  articleId String   @map("article_id")
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([readerId, articleId])
  @@index([readerId, createdAt])
  @@index([articleId])
  @@map("saved_articles")
}

model AnalyticsSession {
  id         String     @id @default(cuid())
  visitorKey String     @map("visitor_key")
  readerId   String?    @map("reader_id")
  reader     Reader?    @relation(fields: [readerId], references: [id], onDelete: SetNull)
  startedAt  DateTime   @default(now()) @map("started_at")
  lastSeenAt DateTime   @default(now()) @map("last_seen_at")
  userAgent  String?    @map("user_agent")
  pageViews  PageView[]

  @@index([visitorKey, startedAt])
  @@index([readerId, startedAt])
  @@index([startedAt])
  @@map("analytics_sessions")
}

model PageView {
  id          String           @id @default(cuid())
  sessionId   String           @map("session_id")
  session     AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  path        String
  articleId   String?          @map("article_id")
  title       String?
  referrer    String?
  utmSource   String?          @map("utm_source")
  utmMedium   String?          @map("utm_medium")
  utmCampaign String?          @map("utm_campaign")
  startedAt   DateTime         @default(now()) @map("started_at")
  dwellMs     Int              @default(0) @map("dwell_ms")
  endedAt     DateTime?        @map("ended_at")

  @@index([startedAt])
  @@index([path, startedAt])
  @@index([articleId, startedAt])
  @@index([sessionId])
  @@index([utmSource, startedAt])
  @@map("page_views")
}

enum StoryYearCampaignStatus {
  DRAFT
  OPEN
  CLOSED
}

/** Contributor achievement badges (e.g. Chronicler after N published stories). */
model Badge {
  id           String        @id @default(cuid())
  slug         String        @unique
  nameBg       String        @map("name_bg")
  nameEn       String?       @map("name_en")
  descriptionBg String       @default("") @map("description_bg")
  descriptionEn String?      @map("description_en")
  /** Lucide-friendly key or short label shown in UI */
  icon         String        @default("award")
  /** Auto-award when author reaches this many PUBLISHED articles. Null = manual only. */
  minPublished Int?          @map("min_published")
  isActive     Boolean       @default(true) @map("is_active")
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  authors      AuthorBadge[]

  @@index([isActive, sortOrder])
  @@map("badges")
}

model AuthorBadge {
  id        String   @id @default(cuid())
  authorId  String   @map("author_id")
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  badgeId   String   @map("badge_id")
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now()) @map("awarded_at")
  /** auto | manual */
  source    String   @default("auto")

  @@unique([authorId, badgeId])
  @@index([badgeId])
  @@map("author_badges")
}

model StoryYearCampaign {
  id             String                   @id @default(cuid())
  year           Int                      @unique
  titleBg        String                   @map("title_bg")
  titleEn        String?                  @map("title_en")
  descriptionBg  String                   @default("") @map("description_bg")
  descriptionEn  String?                  @map("description_en")
  status         StoryYearCampaignStatus  @default(DRAFT)
  opensAt        DateTime?                @map("opens_at")
  closesAt       DateTime?                @map("closes_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  nominations    StoryYearNomination[]
  votes          StoryYearVote[]

  @@map("story_year_campaigns")
}

model StoryYearNomination {
  id         String            @id @default(cuid())
  campaignId String            @map("campaign_id")
  campaign   StoryYearCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  articleId  String            @map("article_id")
  article    Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sortOrder  Int               @default(0) @map("sort_order")
  createdAt  DateTime          @default(now()) @map("created_at")
  votes      StoryYearVote[]

  @@unique([campaignId, articleId])
  @@index([campaignId, sortOrder])
  @@map("story_year_nominations")
}

model StoryYearVote {
  id            String              @id @default(cuid())
  campaignId    String              @map("campaign_id")
  campaign      StoryYearCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  nominationId  String              @map("nomination_id")
  nomination    StoryYearNomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  articleId     String              @map("article_id")
  readerId      String              @map("reader_id")
  reader        Reader              @relation(fields: [readerId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now()) @map("created_at")

  @@unique([campaignId, readerId])
  @@index([nominationId])
  @@index([articleId])
  @@map("story_year_votes")
}
