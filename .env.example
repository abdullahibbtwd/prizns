# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Shared root env â€” used by api/, prizn/, and Docker Compose
# Copy to .env and adjust values for local / docker
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

NODE_ENV=development

# --- API ---
API_PORT=3003
API_PREFIX=api
CORS_ORIGIN=http://localhost:5175

# --- Web (Vite) ---
WEB_PORT=5175
# Stage2 (host nginx in deploy/nginx/stage2.conf): bind Docker to localhost.
# Host nginx then proxies :80 → 127.0.0.1:WEB_PORT. Leave unset for local/Coolify.
# PUBLISH_BIND=127.0.0.1
# Local Vite: absolute localhost API. Coolify/Docker web image: use `/api`
# (nginx proxies to the api container — do NOT bake localhost into the build).
VITE_API_URL=http://localhost:3003/api
VITE_APP_NAME=Prizn
# Coolify example:
# CORS_ORIGIN=http://YOUR_SERVER_IP:5175
# VITE_API_URL=/api
# COOKIE_SECURE=false   # required if you serve over http:// (not https)

# --- PostgreSQL ---
POSTGRES_USER=prizn
POSTGRES_PASSWORD=prizn_secret
POSTGRES_DB=prizn
POSTGRES_PORT=5433
# Local (outside Docker): host = localhost, port = POSTGRES_PORT (5433 avoids a common local Postgres clash)
# Inside Docker Compose the api service overrides host to "postgres" on 5432
DATABASE_URL=postgresql://prizn:prizn_secret@localhost:5433/prizn?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
# Coolify / docker-compose: api service overrides to redis:6379 automatically.
# Prefer leaving REDIS_* as localhost in this file for local-outside-Docker use,
# OR set explicitly on Coolify:
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_URL=redis://redis:6379
# Do not expose Redis publicly unless you need host access.

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_ENDPOINT=localhost
# Port the API uses to reach MinIO — depends on WHERE the API runs:
#   • API on host (npm run start:dev): use the published host port → 9010
#   • API in Docker/Coolify: compose overrides to 9000 (container port)
# Do NOT set Coolify MINIO_PORT=9010 — that breaks in-compose networking.
# MINIO_HOST_PORT is only the host publish mapping (9010→9000). Keep both.
MINIO_PORT=9010
# Host ports published by docker-compose (avoid clash with another MinIO on :9000)
MINIO_HOST_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_CONSOLE_HOST_PORT=9011
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=prizn
MINIO_USE_SSL=false
# Local (API on host): http://localhost:9010  (same as MINIO_HOST_PORT)
# Coolify / docker-compose web: /media  (nginx proxies to MinIO — do NOT use localhost)
# `/media` is valid — do not use IsUrl-only values; path or full URL both work.
#
# Seed journal images use site-root paths (/village.jpg) served by the web container.
# CMS uploads go to MinIO and are served as /media/<bucket>/<key>.
# If /media/... returns MinIO NoSuchKey, the object was never uploaded (common for seed keys).
MINIO_PUBLIC_URL=http://localhost:9010
# Coolify example (set this in Coolify env, or leave unset — compose defaults to /media):
# MINIO_PUBLIC_URL=/media
# MINIO_HOST_PORT=9010

# --- Google Cloud (TTS) ---
# Coolify: paste the service-account JSON as one line (no file mount needed).
# Minify first: jq -c . secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT=
# Local file path still works if you prefer not to put JSON in env:
# GOOGLE_APPLICATION_CREDENTIALS=../secrets/google-service-account.json
FEATURE_TTS=true
TTS_LANGUAGE_CODE=bg-BG
TTS_VOICE_NAME=bg-BG-Standard-A

# --- Phase 2: Gemini AI editorial assistant ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
FEATURE_AI=true

# --- Phase 2: Social desk + Episode of the Day ---
FEATURE_SOCIAL=true
FEATURE_DIGEST=true
FEATURE_SHOP=true
FEATURE_READER_AUTH=true

# Optional frontend mirror (defaults to enabled when unset)
# VITE_FEATURE_READER_AUTH=true

# --- Phase 2: Email (Episode of the Day / newsletter / shop receipts / Magic Link / contact) ---
RESEND_API_KEY=
RESEND_FROM=Prizni <hello@prizni.bg>
# Contact form admin notify (falls back to RESEND_FROM address if unset)
# ADMIN_EMAIL=editor@prizni.bg

# --- Public site (SEO / Stripe redirects) ---
PUBLIC_SITE_URL=http://localhost:5175

# --- Stripe donations + shop (optional; checkout returns 503 if unset) ---
# Shared webhook: POST /api/donations/webhook (metadata.kind = donation | shop)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe settlement currency. Donations UI stays in BGN (лв); API converts at
# the official rate 1 EUR = 1.95583 BGN because Stripe no longer accepts BGN.
STRIPE_CURRENCY=eur

# --- Auth (access + refresh + Redis sessions) ---
# Production: random 32+ character secrets. COOKIE_SECURE=true over HTTPS;
# COOKIE_SECURE=false when CORS_ORIGIN is http:// (IP / no TLS).
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false

# Seeded CMS admin (runs on API boot in Docker unless SEED_ON_BOOT=false)
# Production: set SEED_ON_BOOT=false after first deploy, use a strong unique password (16+ chars),
# and never keep ChangeMeAdmin123!
SEED_ON_BOOT=true
ADMIN_EMAIL=admin@prizn.local
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=Prizn Admin

# --- WordPress import (optional; REST Application Password) ---
# Local export (no Coolify/WP network on VPS):
#   npm run import:wordpress:export
# Then copy wordpress-export/ onto the API container and:
#   docker compose exec api node dist/wordpress-import/import-wordpress.js --package=/app/wordpress-export --users
# Collapse WP city tags onto the CMS tree (Our places / Campaigns):
#   docker compose exec api node dist/wordpress-import/merge-wordpress-categories.js --dry-run
#   docker compose exec api node dist/wordpress-import/merge-wordpress-categories.js
# Omit CMS category records: add --skip-categories
#   node dist/wordpress-import/import-wordpress.js --package=/migration --users
WORDPRESS_URL=https://prizni.bg
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
# Shared CMS password for imported WP users (they change it on Profile after login)
WORDPRESS_IMPORT_USER_PASSWORD=
